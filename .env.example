# Copy this file to .env.local for personal overrides (which is gitignored).
# All variables Vite exposes to the client must be prefixed with VITE_.

# Where the app fetches per-city road JSONs at runtime.
# Default (set in .env): the data sibling-repo's GitHub Pages site.
#
# For fully offline dev, run `pnpm fetch-data` then override here:
# VITE_ROADS_BASE_URL=/city-scale-comparison/data/roads-stitched/
#
# To switch CDNs (e.g. Cloudflare R2), set the bucket's public URL:
# VITE_ROADS_BASE_URL=https://roads.example.com/data-v1/
